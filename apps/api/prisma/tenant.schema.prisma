// Tenant-domain schema template (W2).
// NOTE: This file is documentation/template only.
// Runtime migration for all tenants is executed by scripts/migrate-all-schemas.js.

datasource db {
  provider = "postgresql"
  schemas  = ["homtone", "spoonlemon", "davivy", "tysun"]
}

model Customer {
  id               String   @id
  email            String
  phone            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  passwordHash     String
  emailVerifiedAt  DateTime?
  isActive         Boolean  @default(false)
  name             String?

  warranties         WarrantyRegistration[]
  tickets            Ticket[]
  emailVerifications CustomerEmailVerification[]
  passwordResets     CustomerPasswordReset[]
  refreshTokens      CustomerRefreshToken[]

  @@schema("homtone")
}

model CustomerEmailVerification {
  id         String    @id @default(cuid())
  customerId String
  token      String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_email_verification")
  @@schema("homtone")
}

model CustomerPasswordReset {
  id         String    @id @default(cuid())
  customerId String
  token      String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_password_reset")
  @@schema("homtone")
}

model CustomerRefreshToken {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_refresh_token")
  @@schema("homtone")
}

model WarrantyRegistration {
  id           String   @id
  customerId   String
  productSku   String
  status       String
  registeredAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@schema("homtone")
}

model OrderLookup {
  id          String   @id
  customerId  String?
  orderNumber String
  channel     String?
  createdAt   DateTime @default(now())

  @@schema("homtone")
}

model Ticket {
  id          String   @id
  customerId  String
  ticketNo    String
  subject     String
  status      String
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@schema("homtone")
}
