// Tenant-domain schema template (W2).
// NOTE: This file is documentation/template only.
// Runtime migration for all tenants is executed by scripts/migrate-all-schemas.js.

datasource db {
  provider = "postgresql"
  schemas  = ["homtone", "spoonlemon", "davivy", "tysun"]
}

model Customer {
  id               String   @id
  email            String
  phone            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  passwordHash     String
  emailVerifiedAt  DateTime?
  isActive         Boolean  @default(false)
  name             String?

  warranties         WarrantyRegistration[]
  tickets            Ticket[]
  emailVerifications CustomerEmailVerification[]
  passwordResets     CustomerPasswordReset[]
  refreshTokens      CustomerRefreshToken[]

  @@schema("homtone")
}

model CustomerEmailVerification {
  id         String    @id @default(cuid())
  customerId String
  token      String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_email_verification")
  @@schema("homtone")
}

model CustomerPasswordReset {
  id         String    @id @default(cuid())
  customerId String
  token      String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_password_reset")
  @@schema("homtone")
}

model CustomerRefreshToken {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_refresh_token")
  @@schema("homtone")
}

model WarrantyRegistration {
  id           String   @id
  customerId   String
  productSku   String
  status       String
  registeredAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@schema("homtone")
}

model OrderLookup {
  id          String   @id
  customerId  String?
  orderNumber String
  channel     String?
  createdAt   DateTime @default(now())

  @@schema("homtone")
}

model Ticket {
  id         String    @id @default(cuid())
  customerId String
  sessionId  String?
  ticketNo   String    @unique
  subject    String
  status     String    @default("open")
  priority   String    @default("normal")
  tags       String[]
  assigneeId String?
  slaHours   Int       @default(24)
  slaDueAt   DateTime?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@schema("homtone")
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  senderType String
  content    String
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_message")
  @@schema("homtone")
}

model ChatSession {
  id              String    @id @default(cuid())
  customerId      String?
  sessionToken    String    @unique
  brandId         String
  lastActivityAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())

  messages ChatMessage[]

  @@map("chat_session")
  @@schema("homtone")
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_message")
  @@schema("homtone")
}
