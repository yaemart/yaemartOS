generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

enum UserRole {
  admin
  operator
  viewer

  @@schema("public")
}

enum AuthProvider {
  email
  google
  facebook

  @@schema("public")
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked

  @@schema("public")
}

enum LocaleCode {
  en
  es
  fr
  de
  it

  @@schema("public")
}

enum PlatformCode {
  amazon
  walmart
  shopify
  tiktok

  @@schema("public")
}

enum ListingStatus {
  draft
  review
  approved
  published
  paused
  archived

  @@schema("public")
}

enum ListingVersionStatus {
  draft
  active
  archived

  @@schema("public")
}

enum TrafficStrategy {
  primary
  variant
  bundle
  keyword_grab
  seasonal
  cohort_test

  @@schema("public")
}

enum ProductContentSource {
  manual
  category_inherit
  ai_generated
  erp_import

  @@schema("public")
}

enum ProductContentStatus {
  draft
  review
  approved
  active
  archived

  @@schema("public")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  passwordHash String?
  brandId   String
  role      UserRole @default(operator)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  authAccounts  AuthAccount[]
  refreshTokens RefreshToken[]
  invitations   Invitation[]  @relation("InvitationCreator")
  auditLogs     AuditLog[]

  @@schema("public")
}

model Brand {
  id         String   @id
  name       String
  slug       String   @unique
  themeColor String?
  logoUrl    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users      User[]
  categories Category[]
  products   Product[]
  markets    Market[]
  articles   Article[]
  shops      Shop[]
  listings   Listing[]
  metrics    Metric[]
  invitations Invitation[]

  @@schema("public")
}

model Metric {
  id         String   @id @default(cuid())
  name       String
  value      Decimal  @db.Decimal(18, 6)
  unit       String?
  brandId    String?
  recordedAt DateTime @default(now())

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([name, recordedAt])
  @@schema("public")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  tenant    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenant, action, createdAt])
  @@schema("public")
}

model Invitation {
  id          String           @id @default(cuid())
  email       String
  brandId     String
  role        UserRole
  token       String           @unique
  status      InvitationStatus @default(pending)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  brand     Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy User? @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@schema("public")
}

model AuthAccount {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("public")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@schema("public")
}

model Category {
  id        String   @id @default(cuid())
  brandId   String
  parentId  String?
  name      String
  slug      String
  isActive  Boolean  @default(true)
  requiresRecipe Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand     Brand                     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  parent    Category?                 @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[]                @relation("CategoryToCategory")
  templates CategoryContentTemplate[]
  products  Product[]

  @@unique([brandId, slug])
  @@schema("public")
}

model CategoryContentTemplate {
  id               String     @id @default(cuid())
  categoryId       String
  locale           LocaleCode
  titleTemplate    String?
  bulletsTemplate  Json?
  descriptionGuide String?
  specParams       Json?
  featureWords     Json?
  sellingPoints    Json?
  faqTemplate      Json?
  recipeTemplate   Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@schema("public")
}

model Product {
  id          String   @id @default(cuid())
  brandId     String
  categoryId  String
  sku         String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand    Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  contents ProductContent[]
  listings Listing[]

  @@unique([brandId, sku])
  @@schema("public")
}

model ProductContent {
  id        String               @id @default(cuid())
  productId String
  locale    LocaleCode
  source    ProductContentSource
  status    ProductContentStatus @default(draft)
  payload   Json
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale, source])
  @@schema("public")
}

model Market {
  id        String   @id @default(cuid())
  brandId   String
  code      String
  name      String
  currency  String
  timezone  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand    Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  articles Article[]
  shops    Shop[]
  listings Listing[]

  @@unique([brandId, code])
  @@schema("public")
}

model Article {
  id        String   @id @default(cuid())
  brandId   String
  marketId  String
  slug      String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand  Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, slug])
  @@schema("public")
}

model Platform {
  id        String       @id @default(cuid())
  code      PlatformCode @unique
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  shops    Shop[]
  listings Listing[]

  @@schema("public")
}

model Shop {
  id          String   @id @default(cuid())
  brandId     String
  marketId    String
  platformId  String
  name        String
  externalId  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand    Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  market   Market        @relation(fields: [marketId], references: [id], onDelete: Cascade)
  platform Platform      @relation(fields: [platformId], references: [id], onDelete: Cascade)
  binding  ShopBinding?
  listings Listing[]

  @@unique([platformId, externalId])
  @@schema("public")
}

model ShopBinding {
  id             String   @id @default(cuid())
  shopId         String   @unique
  bindingToken   String
  syncEnabled    Boolean  @default(false)
  lingxingShopId String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Listing {
  id                String          @id @default(cuid())
  productId         String
  brandId           String
  marketId          String
  platformId        String
  shopId            String
  language          LocaleCode
  platformListingId String
  isPrimary         Boolean         @default(false)
  trafficStrategy   TrafficStrategy @default(primary)
  status            ListingStatus   @default(draft)
  title             String?
  bullets           Json?
  description       String?
  searchTerms       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  brand    Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  market   Market           @relation(fields: [marketId], references: [id], onDelete: Cascade)
  platform Platform         @relation(fields: [platformId], references: [id], onDelete: Cascade)
  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  versions ListingVersion[]

  @@unique([platformId, shopId, platformListingId], map: "listing_platform_shop_listing_id_unique")
  @@index([productId, brandId, marketId, platformId, shopId, language])
  @@schema("public")
}

model ListingVersion {
  id              String               @id @default(cuid())
  listingId       String
  versionNumber   Int
  contentSnapshot Json
  status          ListingVersionStatus @default(draft)
  createdBy       String?
  createdAt       DateTime             @default(now())
  publishedAt     DateTime?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, versionNumber])
  @@schema("public")
}
