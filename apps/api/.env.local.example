# ============================================================
# yaemartOS API — .env.local 模板
# 复制本文件为 .env.local，填入真实值（不得提交到 git）
# ============================================================

NODE_ENV=development
PORT=4000

# ── Database: Neon PostgreSQL ─────────────────────────────
# DATABASE_URL: Neon pooled connection (PgBouncer, for app runtime)
DATABASE_URL=postgresql://[USER]:[PASSWORD]@[HOST]-pooler.neon.tech/[DBNAME]?sslmode=require&pgbouncer=true
# DIRECT_URL: Neon direct connection (for prisma migrate/introspect)
DIRECT_URL=postgresql://[USER]:[PASSWORD]@[HOST].neon.tech/[DBNAME]?sslmode=require

# ── Cache: Upstash Redis ───────────────────────────────────
UPSTASH_REDIS_REST_URL=https://[DATABASE-NAME].upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...
REDIS_URL=rediss://default:[PASSWORD]@[DATABASE-NAME].upstash.io:6379

# ── Email: Resend ──────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@mail.yourdomain.com

# ── AI ─────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...
# Optional override (default: gemini-2.0-flash)
# GEMINI_FLASH_MODEL=gemini-2.0-flash

# ── File Storage: Cloudinary ───────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxx...

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET=generate-with-openssl-rand-base64-32
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/oauth/google/callback
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
FACEBOOK_CALLBACK_URL=http://localhost:4000/auth/oauth/facebook/callback

# ── Search: Elasticsearch ──────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ── Monitoring ─────────────────────────────────────────────
SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz

# ── 领星 ERP OpenAPI ───────────────────────────────────────
# LINGXING_APP_KEY=
# LINGXING_APP_SECRET=
# LINGXING_BASE_URL=https://openapi.lingxing.com
