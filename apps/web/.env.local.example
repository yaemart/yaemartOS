# ============================================================
# yaemartOS — .env.local 模板
# 复制本文件为 .env.local，填入真实值（不得提交到 git）
# 凭证统一存入 1Password 团队 vault「yaemartOS-dev」
# ============================================================

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Database: Supabase PostgreSQL ──────────────────────────
# 获取方式：Supabase 控制台 → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# 直连（用于 Prisma migrate）
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── Cache: Upstash Redis ───────────────────────────────────
# 获取方式：Upstash 控制台 → 数据库 → Details → REST URL & Token
UPSTASH_REDIS_REST_URL=https://[DATABASE-NAME].upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...
# BullMQ / ioredis 用原生 Redis URL（仅限 Upstash 付费层或本地 Docker）
REDIS_URL=rediss://default:[PASSWORD]@[DATABASE-NAME].upstash.io:6379

# ── Email: Resend ──────────────────────────────────────────
# 获取方式：resend.com → API Keys → Create API Key
# 发件域名需配置 DKIM（Resend 控制台 → Domains → Add Domain）
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@mail.yourdomain.com

# ── AI: Google Gemini ──────────────────────────────────────
# 获取方式：aistudio.google.com → Get API key
GEMINI_API_KEY=AIza...
# S2 启用智谱 GLM
# ZHIPU_API_KEY=

# ── File Storage: Cloudinary ───────────────────────────────
# 获取方式：cloudinary.com → Dashboard → Account Details
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxx...

# ── Auth (NextAuth / Supabase Auth) ────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# Supabase Auth（备选，与 NextAuth 二选一）
# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Monitoring: Sentry ─────────────────────────────────────
# 获取方式：sentry.io → Project → Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz
SENTRY_AUTH_TOKEN=sntrys_...

# ── E-Commerce Platforms ───────────────────────────────────
# Amazon SP-API（S1 经领星只读，直连凭证 S4 再填）
# AMAZON_CLIENT_ID=
# AMAZON_CLIENT_SECRET=
# AMAZON_REFRESH_TOKEN=

# ── 领星 ERP OpenAPI（S1 只读同步，W7 前申请到账）──────────
# 获取方式：领星后台 → 开发者中心 → 申请 API 凭证（需公司行政审批）
# LINGXING_APP_KEY=
# LINGXING_APP_SECRET=

# ── Deployment: Railway ────────────────────────────────────
# 仅 CI/CD 环境使用，本地不需要
# RAILWAY_TOKEN=
